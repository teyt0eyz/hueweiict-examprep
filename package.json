{
  "name": "hueweiict-examprep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run data && next dev",
    "build": "npm run data && next build",
    "start": "npx serve out",
    "lint": "eslint",
    "validate": "node scripts/validate.mjs",
    "validate:strict": "node scripts/validate.mjs --strict",
    "data": "node scripts/build-data.mjs",
    "mocks": "node scripts/make-mocks.mjs",
    "deploy": "npm run validate && npm run build && rm -rf docs && cp -R out docs && touch docs/.nojekyll"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@types/mdx": "^2.0.14",
    "marked": "^18.2.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
